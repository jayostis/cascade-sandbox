{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A test person",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "birthDate", "gender"],
  "dependentRequired": { "subject": ["kit"], "kit": ["subject"] },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "$ref": "#/$defs/name" },
    "birthDate": { "$ref": "#/$defs/date" },
    "gender": { "$ref": "#/$defs/gender" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iri", "name", "storage"],
      "properties": {
        "iri": { "type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "name": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "pattern": "^https?://" }
      }
    },
    "kit": { "type": "string", "pattern": "^conformance/[a-z0-9-]+$" },
    "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by", "syntheaId", "seed", "clinicianSeed", "referenceDate", "endDate", "arguments", "hospitals"],
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "syntheaId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "seed": { "type": "integer" },
        "clinicianSeed": { "type": "integer" },
        "referenceDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "arguments": { "type": "string" },
        "hospitals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gender": { "enum": ["male", "female", "other", "unknown"] },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "given"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "given": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "field", "value", "reason", "expectedMatch"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "field": { "enum": ["name", "birthDate", "gender"] },
        "value": true,
        "reason": { "type": "string", "minLength": 1 },
        "expectedMatch": { "enum": ["certain", "probable", "possible", "certainly-not"] }
      },
      "allOf": [
        {
          "if": { "properties": { "field": { "const": "name" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/name" } } }
        },
        {
          "if": { "properties": { "field": { "const": "birthDate" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/date" } } }
        },
        {
          "if": { "properties": { "field": { "const": "gender" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/gender" } } }
        }
      ]
    }
  }
}
